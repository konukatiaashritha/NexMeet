# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Frontend
FRONTEND_URL="http://localhost:3000"

# Email (future)
# EMAIL_SERVICE_URL=
# EMAIL_API_KEY=

# SMS (future)
# SMS_API_KEY=

# External Event APIs (future)
# EXTERNAL_EVENT_API_KEYS=

# Storage (future)
# STORAGE_URL=

# Logging
LOG_LEVEL=info
